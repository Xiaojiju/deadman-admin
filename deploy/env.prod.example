# systemd EnvironmentFile。首次部署复制到 ${DEPLOY_DIR}/env 后填真实值。
# 已有 /root/.deadman-infra.env 时，deploy 脚本会自动叠加上面的库/缓存账号。

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
JAVA_OPTS="-Xms512m -Xmx2048m"

# ---- 数据源 / 缓存（与本机 MySQL、Redis 对齐） ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=engineering_info_db
DB_USERNAME=engineering
DB_PASSWORD=change-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=2

# ---- 生产必须关闭 Mock / 支付测试开关 ----
DEADMAN_PLUGIN_PAY_MOCK_ENABLED=false
DEADMAN_PLUGIN_PAY_TEST_MODE_PAYMENT_ENABLED=false
DEADMAN_PLUGIN_PAY_TEST_MODE_SUB_MERCHANT_ENABLED=false
DEADMAN_PLUGIN_PAY_WECHAT_MOCK_ENABLED=false
DEADMAN_PLUGIN_IM_TENCENT_MOCK_ENABLED=false

# ---- JWT / 引导管理员（生产务必改掉默认值） ----
DEADMAN_JWT_SECRET=change-me-at-least-32-characters-long-secret
DEADMAN_CLIENT_JWT_SECRET=change-me-client-jwt-secret-at-least-32-chars
DEADMAN_BOOTSTRAP_ADMIN_ENABLED=true
DEADMAN_SUPER_ADMIN_USERNAME=admin
DEADMAN_SUPER_ADMIN_PASSWORD=change-me-at-least-8-chars
DEADMAN_SUPER_ADMIN_NICKNAME=系统管理员

# ---- 文件 / COS（留空会覆盖 jar 内默认值，未准备好请保持注释） ----
DEADMAN_PLUGIN_FILE_DEFAULT_PROVIDER=cos
# COS_REGION=ap-chengdu
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_DEFAULT_BUCKET=

# ---- 微信小程序 / 支付证书（证书放到 ${DEPLOY_DIR}/certs/） ----
# DEADMAN_WECHAT_MINIPROGRAM_APP_ID=
# DEADMAN_WECHAT_MINIPROGRAM_APP_SECRET=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PRIVATE_KEY_PATH=/opt/deadman/certs/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_PATH=/opt/deadman/certs/pub_key.pem

# ---- 加解密（未配置时使用 jar 内默认密钥；生产建议更换） ----
# DEADMAN_CRYPTO_DEFAULT_KEY=
DEADMAN_CRYPTO_REQUIRE_KEYS=true
