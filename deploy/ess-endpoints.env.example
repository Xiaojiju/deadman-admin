# 腾讯电子签渠道版（essbasic）endpoint
# 切换环境时改 ESS_TENCENT_CHANNEL_ENDPOINT / ESS_TENCENT_FILE_ENDPOINT 后重启即可。

# ---- 联调 ----
# 通用接口（除 UploadFiles）
ESS_TENCENT_CHANNEL_ENDPOINT=essbasic.test.ess.tencent.cn
# 文件服务（UploadFiles）
ESS_TENCENT_FILE_ENDPOINT=file.test.ess.tencent.cn

# ---- 现网（上生产时改用下面两行，注释掉联调） ----
# ESS_TENCENT_CHANNEL_ENDPOINT=essbasic.tencentcloudapi.com
# ESS_TENCENT_FILE_ENDPOINT=file.ess.tencent.cn
