[Unit]
Description=Deadman engineering backend (deadman-app)
After=network-online.target mysqld.service redis.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/deadman
EnvironmentFile=/opt/deadman/env
# JAVA_HOME 由部署脚本写入 env；未设置时使用 PATH 中的 java
ExecStart=/bin/bash -c 'JAVA_BIN="${JAVA_HOME:+$JAVA_HOME/bin/}java"; exec "$JAVA_BIN" ${JAVA_OPTS:--Xms512m -Xmx2048m} -jar /opt/deadman/deadman-app.jar --spring.profiles.active=${SPRING_PROFILES_ACTIVE:-prod} --server.port=${SERVER_PORT:-8080}'
ExecStop=/bin/kill -TERM $MAINPID
SuccessExitStatus=143
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deadman-app

[Install]
WantedBy=multi-user.target
