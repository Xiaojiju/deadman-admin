# 复制为 .env 或在 IDE / 部署环境中配置（勿提交真实密钥到 Git）

DB_HOST=localhost
DB_PORT=3306
DB_NAME=deadman_admin
DB_USERNAME=root
DB_PASSWORD=your_db_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 至少 32 字符
DEADMAN_JWT_SECRET=your-jwt-secret-at-least-32-characters-long
DEADMAN_JWT_ACCESS_EXPIRATION_MS=1800000
DEADMAN_JWT_REFRESH_EXPIRATION_MS=604800000
DEADMAN_JWT_EXPIRATION_MS=1800000
DEADMAN_JWT_REFRESH_COOKIE_SECURE=false
DEADMAN_USER_CODE_PREFIX=DM

# 用户端组件（独立 JWT 与用户表，路径前缀 /client/api）
DEADMAN_COMPONENT_CLIENT_ENABLED=true
DEADMAN_CLIENT_JWT_SECRET=your-client-jwt-secret-at-least-32-characters-long
DEADMAN_CLIENT_JWT_ACCESS_EXPIRATION_MS=1800000
DEADMAN_CLIENT_JWT_REFRESH_EXPIRATION_MS=604800000
DEADMAN_CLIENT_JWT_EXPIRATION_MS=1800000
DEADMAN_CLIENT_JWT_REFRESH_COOKIE_SECURE=false
DEADMAN_CLIENT_USER_CODE_PREFIX=CL
DEADMAN_CLIENT_MULTI_SESSION_ENABLED=true

# 工程信息组件（双 API：/client/api/engineering + /api/engineering）
DEADMAN_COMPONENT_ENGINEERING_ENABLED=true

# 文件存储（默认 cos；可改 local）
DEADMAN_PLUGIN_FILE_ENABLED=true
DEADMAN_PLUGIN_FILE_DEFAULT_PROVIDER=cos
DEADMAN_PLUGIN_STORAGE_LOCAL_ENABLED=true
FILE_STORAGE_PATH=./data/files

# 腾讯云 COS（deadman.plugin.storage-cos）
DEADMAN_PLUGIN_STORAGE_COS_ENABLED=true
COS_REGION=ap-guangzhou
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_DEFAULT_BUCKET=your-default-bucket
# 可选：公开桶 / 私有桶（不配则均回落到 COS_DEFAULT_BUCKET）
COS_BUCKET_PUBLIC=your-public-bucket
COS_BUCKET_PRIVATE=your-private-bucket
# 未配 CDN 时保持 signed；配好 CDN 后可改为 cdn，并在 application.yaml 的 cdn-domains 填桶名→域名
COS_PUBLIC_URL_MODE=signed
COS_SIGNED_URL_EXPIRE_SECONDS=3600
# COS_PATH_PREFIX=
# COS_CDN_PUBLIC=https://cdn-public.example.com
# COS_CDN_PRIVATE=

# 微信小程序插件
DEADMAN_PLUGIN_WECHAT_MINIPROGRAM_ENABLED=true
DEADMAN_WECHAT_MINIPROGRAM_APP_ID=your-wechat-miniprogram-app-id
DEADMAN_WECHAT_MINIPROGRAM_APP_SECRET=your-wechat-miniprogram-app-secret

# 微信网页扫码登录插件（开放平台网站应用，默认关闭）
DEADMAN_PLUGIN_WECHAT_WEB_ENABLED=false
DEADMAN_WECHAT_WEB_APP_ID=your-wechat-open-platform-web-app-id
DEADMAN_WECHAT_WEB_APP_SECRET=your-wechat-open-platform-web-app-secret
DEADMAN_WECHAT_WEB_REDIRECT_URI=https://your-frontend.example.com/auth/wechat/callback
DEADMAN_WECHAT_WEB_STATE_TTL=5m

# 管理端微信桥接（support 模块，仅 admin 组）
DEADMAN_SUPPORT_WECHAT_ENABLED=true
DEADMAN_SUPPORT_WECHAT_BIND_TOKEN_TTL=10m

# 加解密（Base64 编码的 32 字节 AES-256；可用 openssl rand -base64 32 生成）
# 本地占位密钥，生产务必更换
DEADMAN_CRYPTO_DEFAULT_KEY=tLNoqYPUm55T5YEf7BCcC9b3wkyYE7q/9+63+shhkCI=
DEADMAN_CRYPTO_PAY_KEY=tLNoqYPUm55T5YEf7BCcC9b3wkyYE7q/9+63+shhkCI=

# 启动引导：系统中无 SUPER_ADMIN 时自动创建/绑定管理员（生产务必修改密码）
DEADMAN_BOOTSTRAP_ADMIN_ENABLED=true
DEADMAN_SUPER_ADMIN_USERNAME=admin
DEADMAN_SUPER_ADMIN_PASSWORD=change-me-at-least-8-chars
DEADMAN_SUPER_ADMIN_NICKNAME=系统管理员
